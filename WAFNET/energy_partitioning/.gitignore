# WAFNET-local data — same convention as the repo-root .gitignore
# (CLAUDE.md Hard Rule #4): raw downloads, extracted archives, and
# processed intermediates are regenerated by code/ and never committed.
data/raw/
data/extracted/
data/processed/

# Download/extract logs — kept locally, not git-tracked (mirrors repo-root
# logs/ convention: informative but not part of the reviewed record).
logs/*.log
